# ==============================================================================
# Server-side Environment Variables (NEVER prefix private keys with VITE_)
# Configure these in Vercel Dashboard:
#   Project Settings -> Environment Variables
# ==============================================================================

# Required: Google Gemini API Key (used only by /api/recommend-outfit & server.ts)
GEMINI_API_KEY=

# Optional: Public application URL (auto-injected in AI Studio; optional on Vercel)
APP_URL=
